# GEMINI_API_KEY: Required for Gemini AI API calls (the Namo AI chat and the
# AI trip planner on the Map tab). Server-side only; never sent to the browser.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# This placeholder counts as no key: the chat then gives labelled built-in
# answers, and the trip planner says AI planning is not set up.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Map and nearby places (all optional; defaults are the free public
# --- OpenStreetMap services, fine for a demo but not for Kumbh-scale traffic)
# OVERPASS_API_URLS: comma-separated Overpass endpoints, tried in order.
# Point this at a self-hosted or paid Overpass for production.
# OVERPASS_API_URLS="https://overpass.example.org/api/interpreter"
# NOMINATIM_API_URL: base URL of a Nominatim server (the /search path is added).
# NOMINATIM_API_URL="https://nominatim.example.org"
# GEO_CONTACT: contact added to the User-Agent sent to those services, e.g. a
# project URL or team mailbox, so their operators can reach you.
# GEO_CONTACT="MY_CONTACT_URL_OR_EMAIL"

# --- Road routes on the map (route planner)
# OPENROUTESERVICE_API_KEY: server-side only; never sent to the browser or logged.
# Get a free key at https://account.heigit.org (Standard plan: 2,000 directions
# a day, 40 a minute). Without a real key the route planner says routing is not
# set up and shows no routes, distances or times. This placeholder counts as no key.
OPENROUTESERVICE_API_KEY="MY_OPENROUTESERVICE_API_KEY"
# OPENROUTESERVICE_API_URL: only for a self-hosted openrouteservice, e.g.
# "https://ors.example.org/ors/v2" (/directions/<profile>/geojson is added).
# Defaults to https://api.heigit.org/openrouteservice/v2. Never use the retired
# api.openrouteservice.org host.
# OPENROUTESERVICE_API_URL="https://ors.example.org/ors/v2"
